'use client';

import { useEffect, useRef } from 'react';
import { Swiper, SwiperSlide } from 'swiper/react';
import { Autoplay, Navigation, Pagination } from 'swiper/modules';

// Import Swiper styles
import 'swiper/css';
import 'swiper/css/navigation';
import 'swiper/css/pagination';
import 'swiper/css/autoplay';

/**
 * Swiper Slider component for Next.js.
 * 
 * Usage:
 * import { SwiperSlider } from '@/components/swiper-slider';
 * 
 * <SwiperSlider
 *   slides={[
 *     { id: 1, content: <div>Slide 1</div> },
 *     { id: 2, content: <div>Slide 2</div> },
 *   ]}
 *   slidesPerView={3}
 *   loop={true}
 *   autoplay={true}
 * />
 */
export function SwiperSlider({
  slides,
  slidesPerView = 1,
  spaceBetween = 10,
  loop = true,
  autoplay = true,
  navigation = true,
  pagination = true,
  className = '',
}: {
  slides: Array<{ id: string | number; content: React.ReactNode }>;
  slidesPerView?: number;
  spaceBetween?: number;
  loop?: boolean;
  autoplay?: boolean | object;
  navigation?: boolean | object;
  pagination?: boolean | object;
  className?: string;
}) {
  const swiperRef = useRef<any>(null);

  // Autoplay configuration
  const autoplayConfig = autoplay ? {
    delay: 5000,
    disableOnInteraction: false,
    ...(typeof autoplay === 'object' ? autoplay : {}),
  } : undefined;

  // Navigation configuration
  const navigationConfig = navigation ? {
    nextEl: `.swiper-button-next-${Math.random().toString(36).substr(2, 9)}`,
    prevEl: `.swiper-button-prev-${Math.random().toString(36).substr(2, 9)}`,
    ...(typeof navigation === 'object' ? navigation : {}),
  } : undefined;

  // Pagination configuration
  const paginationConfig = pagination ? {
    clickable: true,
    ...(typeof pagination === 'object' ? pagination : {}),
  } : undefined;

  return (
    <div className={`swiper-container-wrapper ${className}`}>
      <Swiper
        ref={swiperRef}
        modules={[Autoplay, Navigation, Pagination]}
        slidesPerView={slidesPerView}
        spaceBetween={spaceBetween}
        loop={loop}
        autoplay={autoplayConfig}
        navigation={navigationConfig}
        pagination={paginationConfig}
        className="swiper-container"
      >
        {slides.map((slide) => (
          <SwiperSlide key={slide.id} className="swiper-slide">
            {slide.content}
          </SwiperSlide>
        ))}
      </Swiper>
      
      {navigation && (
        <>
          <div className="swiper-button-prev" />
          <div className="swiper-button-next" />
        </>
      )}
      
      {pagination && <div className="swiper-pagination" />}
    </div>
  );
}

export default SwiperSlider;
