/**
 * Paddle Webhook Handler
 * 
 * Handles Paddle webhook events for subscriptions, payments, and cancellations.
 * 
 * Source: https://developer.paddle.com/webhooks
 * Verified: 2026-09-06
 */

import { NextRequest, NextResponse } from 'next/server';
import { verifyPaddleWebhook, getPaddleVendorId } from '@/lib/paddle';

export async function POST(request: NextRequest) {
  try {
    // Verify webhook signature
    const webhookSecret = process.env.PADDLE_WEBHOOK_SECRET || '';
    
    if (!verifyPaddleWebhook(request, webhookSecret)) {
      return NextResponse.json(
        { error: 'Invalid webhook signature' },
        { status: 401 }
      );
    }

    // Parse the webhook payload
    const payload = await request.json();
    
    // Extract event data
    const alertName = payload.alert_name;
    const alertId = payload.alert_id;
    const vendorId = payload.vendor_id;
    const passthrough = payload.passthrough;

    // Verify vendor ID matches our account
    const expectedVendorId = getPaddleVendorId();
    if (vendorId !== expectedVendorId) {
      return NextResponse.json(
        { error: 'Invalid vendor ID' },
        { status: 400 }
      );
    }

    // Handle different webhook events
    switch (alertName) {
      case 'subscription_created':
        // New subscription created
        await handleSubscriptionCreated(payload);
        break;

      case 'subscription_updated':
        // Subscription updated (plan change, etc.)
        await handleSubscriptionUpdated(payload);
        break;

      case 'subscription_cancelled':
        // Subscription cancelled
        await handleSubscriptionCancelled(payload);
        break;

      case 'payment_succeeded':
        // One-time payment succeeded
        await handlePaymentSucceeded(payload);
        break;

      case 'payment_failed':
        // Payment failed
        await handlePaymentFailed(payload);
        break;

      default:
        console.log(`Unhandled Paddle webhook event: ${alertName}`);
    }

    // Return 200 to acknowledge receipt
    return NextResponse.json({ 
      success: true, 
      alertId, 
      alertName 
    });

  } catch (error) {
    console.error('Paddle webhook error:', error);
    return NextResponse.json(
      { error: 'Failed to process webhook' },
      { status: 500 }
    );
  }
}

