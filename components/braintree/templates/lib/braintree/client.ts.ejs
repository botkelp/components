/**
 * Braintree client initialization.
 * 
 * This module initializes the Braintree client for use in Next.js applications.
 * The client authorization token should be generated server-side and passed
 * to the client via environment variables or API calls.
 * 
 * See: https://braintree.github.io/braintree-web/current/
 */

// Import type declarations
import type { ClientInstance } from 'braintree-web';

export const getBraintreeClient = async (): Promise<ClientInstance> => {
  const authorization = process.env.NEXT_PUBLIC_BRAINTREE_AUTHORIZATION;
  
  if (!authorization) {
    throw new Error('NEXT_PUBLIC_BRAINTREE_AUTHORIZATION is not defined');
  }

  try {
    // @ts-ignore - braintree-web doesn't have TypeScript types, using our custom declarations
    const braintree = await import('braintree-web');
    const braintreeClient = await braintree.client.create({
      authorization: authorization,
    });
    return braintreeClient;
  } catch (error) {
    console.error('Failed to initialize Braintree client:', error);
    throw error;
  }
};
