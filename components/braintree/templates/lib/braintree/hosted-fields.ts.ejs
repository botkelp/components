/**
 * Braintree Hosted Fields integration.
 * 
 * Hosted Fields allow you to collect payment information directly on your
 * site without the information touching your servers. The fields are hosted
 * by Braintree and returned as a payment method nonce.
 * 
 * See: https://braintree.github.io/braintree-web/current/module-braintree-web-hosted-fields.html
 */

// Import type declarations
import type { HostedFieldsInstance, HostedFieldsEvent, TokenizeResponse } from 'braintree-web';
import { getBraintreeClient } from './client';

export interface HostedFieldsOptions {
  containerId: string;
  onSuccess: (token: string) => void;
  onError: (error: unknown) => void;
}

export interface HostedFieldsResult {
  hostedFieldsInstance: HostedFieldsInstance;
  tokenize: () => Promise<TokenizeResponse>;
  teardown: () => Promise<void>;
}

export const setupHostedFields = async (options: HostedFieldsOptions): Promise<HostedFieldsResult> => {
  const { containerId, onSuccess, onError } = options;
  const braintreeClient = await getBraintreeClient();

  try {
    // @ts-ignore - braintree-web doesn't have TypeScript types, using our custom declarations
    const braintree = await import('braintree-web');
    const hostedFieldsInstance = await braintree.hostedFields.create({
      client: braintreeClient,
      styles: {
        input: {
          'font-size': '16px',
          'font-family': 'helvetica, tahoma, calibri, sans-serif',
          color: '#333',
        },
        '.number': {
          'font-family': 'monospace',
        },
        '.valid': {
          color: 'green',
        },
      },
      fields: {
        number: {
          selector: `#${containerId}-number`,
          placeholder: 'Card Number',
        },
        cvv: {
          selector: `#${containerId}-cvv`,
          placeholder: 'CVV',
        },
        expirationDate: {
          selector: `#${containerId}-expiration`,
          placeholder: 'MM/YY',
        },
      },
    });

    hostedFieldsInstance.on('validityChange', (event: HostedFieldsEvent) => {
      const field = event.fields[event.emittedBy];
      if (field?.isValid) {
        console.log(`${event.emittedBy} is valid`);
      } else {
        console.log(`${event.emittedBy} is invalid`);
      }
    });

    hostedFieldsInstance.on('cardTypeChange', (event: HostedFieldsEvent) => {
      console.log('Card type changed:', event.cards);
    });

    return {
      hostedFieldsInstance,
      tokenize: async () => {
        try {
          const result = await hostedFieldsInstance.tokenize();
          onSuccess(result.nonce);
          return result;
        } catch (err) {
          onError(err as unknown);
          throw err;
        }
      },
      teardown: async () => {
        await hostedFieldsInstance.teardown();
      },
    };
  } catch (error) {
    onError(error as unknown);
    throw error;
  }
};
