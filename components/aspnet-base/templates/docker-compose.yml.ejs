/**
 * Docker Compose Configuration for ASP.NET Core
 * 
 * This configuration sets up ASP.NET Core with SQL Server and Redis.
 * 
 * Source: https://learn.microsoft.com/en-us/dotnet/core/docker/
 * Verified: 2026-09-06
 */

version: '3.8'

services:
  web:
    build: .
    container_name: aspnetcore_app
    restart: unless-stopped
    environment:
      - ASPNETCORE_ENVIRONMENT=${ASPNETCORE_ENVIRONMENT:-Production}
      - ASPNETCORE_URLS=${ASPNETCORE_URLS:-http://+:8080}
      - CONNECTIONSTRINGS__DEFAULT=${CONNECTION_STRING:-Server=sqlserver;Database=<%= projectName || 'AspNetCoreApp' %>;User Id=sa;Password=YourPassword123;TrustServerCertificate=True;}
      - JWT__SECRET=${JWT_SECRET:-change-this-in-production-use-32-characters-or-more}
      - JWT__ISSUER=${JWT_ISSUER:-<%= projectName || 'AspNetCoreApp' %>}
      - JWT__AUDIENCE=${JWT_AUDIENCE:-<%= projectName || 'AspNetCoreApp' %>-client}
    ports:
      - "8080:8080"
    depends_on:
      sqlserver:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:8080/health"]
      interval: 30s
      timeout: 10s
      retries: 3

  sqlserver:
    image: mcr.microsoft.com/mssql/server:2022-latest
    container_name: aspnetcore_sqlserver
    restart: unless-stopped
    environment:
      ACCEPT_EULA: "Y"
      SA_PASSWORD: "YourPassword123"
      MSSQL_PID: "Developer"
    ports:
      - "1433:1433"
    volumes:
      - sqlserver_data:/var/opt/mssql
    healthcheck:
      test: ["CMD", "/opt/mssql-tools18/bin/sqlcmd", "-S", "localhost", "-U", "sa", "-P", "YourPassword123", "-Q", "SELECT 1"]
      interval: 10s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    container_name: aspnetcore_redis
    restart: unless-stopped
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

volumes:
  sqlserver_data:
    driver: local
  redis_data:
    driver: local
