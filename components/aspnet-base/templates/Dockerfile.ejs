/**
 * Dockerfile for ASP.NET Core Application
 * 
 * Multi-stage build optimized for production deployment.
 * 
 * Source: https://learn.microsoft.com/en-us/dotnet/core/docker/
 * Verified: 2026-09-06
 */

# Stage 1: Build stage
FROM mcr.microsoft.com/dotnet/sdk:8.0 as build

# Set working directory
WORKDIR /src

# Copy project files
COPY *.csproj ./
COPY *.json ./
COPY Program.cs ./
COPY Controllers/ ./Controllers/
COPY Models/ ./Models/
COPY Properties/ ./Properties/

# Restore dependencies
RUN dotnet restore "<%= projectName || 'AspNetCoreApp' %>.csproj"

# Build the application
RUN dotnet publish "<%= projectName || 'AspNetCoreApp' %>.csproj" -c Release -o /app/publish \
    --no-restore \
    -p:PublishReadyToRun=true \
    -p:PublishSingleFile=false \
    -p:PublishTrimmed=true

# Stage 2: Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:8.0

# Set working directory
WORKDIR /app

# Copy published files from build stage
COPY --from=build /app/publish ./

# Set environment variables
ENV ASPNETCORE_ENVIRONMENT=Production \
    ASPNETCORE_URLS=http://+:8080

# Expose port 8080
EXPOSE 8080

# Start the application
ENTRYPOINT ["dotnet", "<%= projectName || 'AspNetCoreApp' %>.dll"]
