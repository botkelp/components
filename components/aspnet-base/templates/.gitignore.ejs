## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# User-specific files
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleasePublic/
x64/
x86/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# NuGet Packages
*.nupkg
packages/

# Microsoft Azure Build Output
csx/
*.build.csdef

# Microsoft Azure Emulator
AzureStorageEmulator/

# Windows Store app packages
AppPackages/

# Visual Studio Tools for Apache Cordova
vs-tac/

# Visual Studio Code files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Local History for Visual Studio Code
.history/

# Built Visual Studio Code Extensions
*.vsix

# DUNIT test results
TestResults/

# Build results of an ATL project
[Dd]ebugPS/
[Rr]eleasePS/
dlldata.c

# .NET Core
bin/
obj/

# NuGet
packages/

# IDE
.idea/
*.swp
*.swo

# Docker
.docker/

# Environment files
.env
.env.local
.env.*.local

# Logs
logs/
*.log

# Test results
TestResults/
coverage/
