using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

namespace <%= projectName || 'AspNetCoreApp' %>.Models;

/// <summary>
/// Represents an example entity.
/// </summary>
public class Example
{
    /// <summary>
    /// Gets or sets the ID of the example.
    /// </summary>
    [Key]
    [DatabaseGenerated(DatabaseGeneratedOption.Identity)]
    public int Id { get; set; }

    /// <summary>
    /// Gets or sets the name of the example.
    /// </summary>
    [Required]
    [MaxLength(255)]
    public string Name { get; set; } = null!;

    /// <summary>
    /// Gets or sets the slug of the example.
    /// </summary>
    [MaxLength(255)]
    public string? Slug { get; set; }

    /// <summary>
    /// Gets or sets the description of the example.
    /// </summary>
    [MaxLength(1000)]
    public string? Description { get; set; }

    /// <summary>
    /// Gets or sets the count of the example.
    /// </summary>
    [Range(0, 1000)]
    public int Count { get; set; }

    /// <summary>
    /// Gets or sets a value indicating whether the example is active.
    /// </summary>
    public bool IsActive { get; set; } = true;

    /// <summary>
    /// Gets or sets a value indicating whether the example is featured.
    /// </summary>
    public bool IsFeatured { get; set; } = false;

    /// <summary>
    /// Gets or sets the creation timestamp.
    /// </summary>
    [DatabaseGenerated(DatabaseGeneratedOption.Computed)]
    public DateTime CreatedAt { get; set; }

    /// <summary>
    /// Gets or sets the last update timestamp.
    /// </summary>
    public DateTime UpdatedAt { get; set; }
}
