/**
 * NestJS Prettier Configuration
 * 
 * This file configures Prettier for the NestJS application.
 * 
 * Source: https://docs.nestjs.com/first-steps
 * Verified: 2026-09-06
 */

{
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "endOfLine": "lf"
}
