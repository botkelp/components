/**
 * NestJS Root Application Service
 * 
 * This service provides the business logic for the root controller.
 * 
 * Source: https://docs.nestjs.com/providers
 * Verified: 2026-09-06
 */

import { Injectable } from '@nestjs/common';
import { ConfigService } from './config/configuration';

@Injectable()
export class AppService {
  constructor(private readonly configService: ConfigService) {}

  getRootInfo() {
    const appName = this.configService.get('APP_NAME') || '<%= projectName || 'NestJS API' %>';
    const apiPrefix = this.configService.get('API_PREFIX') || 'api';

    return {
      name: appName,
      version: '1.0.0',
      description: 'NestJS backend application generated by BotKelp',
      docs: `/${apiPrefix}/docs`,
      health: `/${apiPrefix}/health`,
    };
  }

  getHealth() {
    return {
      status: 'ok',
      message: 'NestJS is running',
      timestamp: new Date().toISOString(),
    };
  }
}
