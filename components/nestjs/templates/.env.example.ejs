/**
 * NestJS Environment Configuration
 * 
 * Copy this file to .env and update the values for your environment.
 * 
 * Source: https://docs.nestjs.com/techniques/configuration
 * Verified: 2026-09-06
 */

# Application settings
NODE_ENV=development
PORT=3000
API_PREFIX=/api
APP_NAME=<%= projectName || 'NestJS API' %>

# CORS configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://127.0.0.1:3000
CORS_METHODS=GET,HEAD,PUT,PATCH,POST,DELETE,OPTIONS
CORS_CREDENTIALS=false

# Database configuration (example for PostgreSQL)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=nestjs_app
# DB_USER=postgres
# DB_PASSWORD=postgres

# JWT configuration (for authentication)
# JWT_SECRET=change-this-in-production-use-32-characters-or-more
# JWT_ISSUER=<%= projectName || 'NestJS API' %>
# JWT_AUDIENCE=<%= projectName || 'NestJS API' %>-client
# JWT_EXPIRES_IN=1d

# Rate limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100

# Logging
# LOG_LEVEL=info
# LOG_FORMAT=combined
