{
  "id": "svelte-base",
  "name": "SvelteKit Base",
  "version": "1.0.0",
  "description": "Minimal SvelteKit project with TypeScript. Provides a foundation for Svelte applications with file-based routing and server-side rendering. Packages pinned to svelte@5.0.0, @sveltejs/kit@2.0.0 (verified 2026-09-06).",
  "requires": [],
  "conflictsWith": ["nextjs-base", "vue-base", "angular-base"],
  "provides": ["framework"],
  "dependencies": ["@sveltejs/kit"],
  "devDependencies": [
    "svelte",
    "typescript",
    "@sveltejs/vite-plugin-svelte",
    "@sveltejs/adapter-node",
    "vite"
  ],
  "envVariables": [],
  "sources": [
    {
      "type": "docs",
      "label": "SvelteKit official documentation",
      "url": "https://kit.svelte.dev/docs/introduction",
      "verifiedAt": "2026-09-06"
    },
    {
      "type": "docs",
      "label": "Svelte documentation",
      "url": "https://svelte.dev/docs/introduction",
      "verifiedAt": "2026-09-06"
    },
    {
      "type": "github-releases",
      "label": "sveltejs/kit v2.0.0",
      "url": "https://github.com/sveltejs/kit/releases/tag/svelte-kit-2.0.0",
      "verifiedAt": "2026-09-06"
    },
    {
      "type": "github-examples",
      "label": "Official SvelteKit starter template",
      "url": "https://github.com/sveltejs/kit/tree/svelte-kit-2.0.0/sites/kit.svelte.dev",
      "verifiedAt": "2026-09-06"
    }
  ],
  "actions": [
    {
      "type": "create_file",
      "templatePath": "templates/package.json.ejs",
      "destination": "package.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/tsconfig.json.ejs",
      "destination": "tsconfig.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/svelte.config.js.ejs",
      "destination": "svelte.config.js"
    },
    {
      "type": "create_file",
      "templatePath": "templates/vite.config.ts.ejs",
      "destination": "vite.config.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app.html.ejs",
      "destination": "src/app.html"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app.css.ejs",
      "destination": "src/app.css"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/routes/+page.svelte.ejs",
      "destination": "src/routes/+page.svelte"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/routes/+layout.svelte.ejs",
      "destination": "src/routes/+layout.svelte"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/lib/counter.ts.ejs",
      "destination": "src/lib/counter.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/README.md.ejs",
      "destination": "README.md"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.gitignore.ejs",
      "destination": ".gitignore"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.env.example.ejs",
      "destination": ".env.example"
    }
  ]
}
