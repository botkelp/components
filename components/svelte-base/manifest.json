{
  "id": "svelte-base",
  "name": "SvelteKit Base",
  "version": "2.0.0",
  "description": "Minimal SvelteKit 3 project with TypeScript. Packages pinned to @sveltejs/kit@3.1.0, svelte@5.57.3. Config now lives in vite.config.ts.",
  "requires": [],
  "conflictsWith": [
    "nextjs-base",
    "vue-base",
    "angular-base"
  ],
  "provides": [
    "framework"
  ],
  "dependencies": [
    "@sveltejs/kit"
  ],
  "devDependencies": [
    "svelte",
    "typescript",
    "@sveltejs/vite-plugin-svelte",
    "@sveltejs/adapter-node",
    "vite"
  ],
  "envVariables": [],
  "sources": [
    {
      "type": "docs",
      "label": "Migrating to SvelteKit v3",
      "url": "https://svelte.dev/docs/kit/migrating-to-sveltekit-3",
      "verifiedAt": "2026-10-29"
    },
    {
      "type": "github-releases",
      "label": "sveltejs/kit @sveltejs/kit@3.1.0",
      "url": "https://github.com/sveltejs/kit/releases/tag/%40sveltejs%2Fkit%403.1.0",
      "verifiedAt": "2026-10-29"
    },
    {
      "type": "github-examples",
      "label": "Official sv migrate sveltekit-3",
      "url": "https://svelte.dev/docs/cli/sv-migrate",
      "verifiedAt": "2026-10-29"
    }
  ],
  "actions": [
    {
      "type": "create_file",
      "templatePath": "templates/package.json.ejs",
      "destination": "package.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/tsconfig.json.ejs",
      "destination": "tsconfig.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/vite.config.ts.ejs",
      "destination": "vite.config.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app.html.ejs",
      "destination": "src/app.html"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app.css.ejs",
      "destination": "src/app.css"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/routes/+page.svelte.ejs",
      "destination": "src/routes/+page.svelte"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/routes/+layout.svelte.ejs",
      "destination": "src/routes/+layout.svelte"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/lib/counter.ts.ejs",
      "destination": "src/lib/counter.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/README.md.ejs",
      "destination": "README.md"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.gitignore.ejs",
      "destination": ".gitignore"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.env.example.ejs",
      "destination": ".env.example"
    },
    {
      "type": "create_file",
      "templatePath": "templates/github-workflows-ci.yml.ejs",
      "destination": ".github/workflows/ci.yml"
    }
  ],
  "compatibility": {
    "svelte": ">=5 <6"
  },
  "status": "stable"
}
