# SQL Server Database Configuration
# 
# Copy this file to .env and update the values
# 
# Source: https://www.prisma.io/docs/prisma-orm/quickstart/sql-server
# Verified: 2026-09-06

# SQL Server connection URL for Prisma
# Format: sqlserver://HOST:PORT;database=DATABASE;user=USER;password=PASSWORD;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=${SQLSERVER_DATABASE:-mydb};user=${SQLSERVER_USER:-sa};password=${SQLSERVER_PASSWORD:-YourStrong@Passw0rd};trustServerCertificate=true"

# SQL Server credentials
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=YourStrong@Passw0rd
SQLSERVER_DATABASE=mydb

# Root SA password (for Docker)
SA_PASSWORD=YourStrong@Passw0rd
