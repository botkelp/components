/**
 * Auth0 has no custom login form to build — /auth/login redirects to Auth0's
 * hosted Universal Login page, and /auth/logout ends the session. This page
 * just shows the current session state and links to those built-in routes.
 *
 * Source: https://github.com/auth0/nextjs-auth0/blob/v4.29.0/README.md
 * Verified: 2026-09-06
 */
import { auth0 } from "@/lib/auth0";

export default async function LoginPage() {
  const session = await auth0.getSession();

  if (!session) {
    return (
      <main className="mx-auto flex min-h-screen max-w-sm flex-col justify-center gap-4 p-6">
        <h1 className="text-2xl font-semibold">Sign in</h1>
        <a
          href="/auth/login"
          className="rounded-md bg-slate-900 px-4 py-2 text-center text-white"
        >
          Log in
        </a>
        <a href="/auth/login?screen_hint=signup" className="text-center text-sm text-slate-600">
          Sign up
        </a>
      </main>
    );
  }

  return (
    <main className="mx-auto flex min-h-screen max-w-sm flex-col justify-center gap-4 p-6">
      <h1 className="text-2xl font-semibold">Welcome, {session.user.name}</h1>
      <a
        href="/auth/logout"
        className="rounded-md border border-slate-200 px-4 py-2 text-center"
      >
        Log out
      </a>
    </main>
  );
}
