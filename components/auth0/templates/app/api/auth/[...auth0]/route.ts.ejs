/**
 * Auth0 API Route Handler
 * 
 * Handles Auth0 authentication callbacks and API routes.
 * 
 * Source: https://auth0.com/docs/integrations/next-js-app-router
 * Verified: 2026-09-06
 */

import { handleAuth } from '@auth0/auth0-nextjs';
import { NextRequest, NextResponse } from 'next/server';

// Handle all Auth0 routes (callback, login, logout, etc.)
export async function GET(request: NextRequest) {
  try {
    const response = await handleAuth(request);
    return response || NextResponse.json({ error: 'Not found' }, { status: 404 });
  } catch (error) {
    console.error('Auth0 handler error:', error);
    return NextResponse.json(
      { error: 'Authentication failed' },
      { status: 500 }
    );
  }
}

// Handle POST requests for Auth0 (e.g., login)
export async function POST(request: NextRequest) {
  try {
    const response = await handleAuth(request);
    return response || NextResponse.json({ error: 'Not found' }, { status: 404 });
  } catch (error) {
    console.error('Auth0 handler error:', error);
    return NextResponse.json(
      { error: 'Authentication failed' },
      { status: 500 }
    );
  }
}
