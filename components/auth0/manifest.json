{
  "id": "auth0",
  "name": "Auth0 Authentication",
  "version": "1.0.0",
  "description": "Auth0 authentication integration for Next.js App Router. Includes Auth0 provider, SDK configuration, and callback routes. Packages pinned to @auth0/auth0-nextjs@4.0.0 (verified 2026-09-06).",
  "requires": ["nextjs-base"],
  "conflictsWith": ["supabase-auth-ui", "authjs", "clerk", "firebase-auth"],
  "provides": ["authentication"],
  "dependencies": ["@auth0/auth0-nextjs"],
  "devDependencies": [],
  "envVariables": [
    "AUTH0_SECRET",
    "AUTH0_BASE_URL",
    "AUTH0_ISSUER_BASE_URL",
    "AUTH0_CLIENT_ID",
    "AUTH0_CLIENT_SECRET",
    "NEXT_PUBLIC_AUTH0_DOMAIN"
  ],
  "sources": [
    {
      "type": "docs",
      "label": "Auth0 Next.js SDK documentation",
      "url": "https://auth0.com/docs/quickstart/spa/nextjs",
      "verifiedAt": "2026-09-06"
    },
    {
      "type": "docs",
      "label": "Auth0 Next.js App Router integration",
      "url": "https://auth0.com/docs/integrations/next-js-app-router",
      "verifiedAt": "2026-09-06"
    },
    {
      "type": "github-releases",
      "label": "auth0/auth0-nextjs v4.0.0",
      "url": "https://github.com/auth0/auth0-nextjs/releases/tag/v4.0.0",
      "verifiedAt": "2026-09-06"
    },
    {
      "type": "github-examples",
      "label": "Official Auth0 Next.js example",
      "url": "https://github.com/auth0/auth0-nextjs/tree/v4.0.0/examples/app-router",
      "verifiedAt": "2026-09-06"
    }
  ],
  "actions": [
    {
      "type": "create_file",
      "templatePath": "templates/lib/auth0.ts.ejs",
      "destination": "lib/auth0.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/app/api/auth/[...auth0]/route.ts.ejs",
      "destination": "app/api/auth/[...auth0]/route.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/app/login/page.tsx.ejs",
      "destination": "app/login/page.tsx"
    },
    {
      "type": "create_file",
      "templatePath": "templates/app/api/auth/user/route.ts.ejs",
      "destination": "app/api/auth/user/route.ts"
    },
    {
      "type": "json_merge",
      "targetFile": "package.json",
      "mergeData": {
        "dependencies": {
          "@auth0/auth0-nextjs": "4.0.0"
        }
      }
    }
  ]
}
