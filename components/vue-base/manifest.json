{
  "id": "vue-base",
  "name": "Vue Base",
  "version": "2.0.0",
  "description": "Vue.js frontend project with Vue 3.5, Vite 8, Pinia 3, and Vue Router 5. Packages pinned to vue@3.5.44 (latest stable; 3.6 is still RC), vue-router@5.1.1.",
  "requires": [],
  "conflictsWith": [
    "nextjs-base",
    "angular-base",
    "svelte-base"
  ],
  "provides": [
    "framework"
  ],
  "dependencies": [
    "vue",
    "pinia",
    "vue-router"
  ],
  "devDependencies": [
    "@vitejs/plugin-vue",
    "vite",
    "@types/node",
    "typescript",
    "prettier",
    "eslint",
    "eslint-plugin-vue",
    "@vue/test-utils",
    "vitest",
    "jsdom"
  ],
  "envVariables": [
    "VITE_APP_NAME",
    "VITE_API_URL"
  ],
  "sources": [
    {
      "type": "docs",
      "label": "Vue Router 5 migration (no breaking changes for non-file-based routing)",
      "url": "https://router.vuejs.org/guide/migration/v4-to-v5",
      "verifiedAt": "2026-10-29"
    },
    {
      "type": "github-releases",
      "label": "vuejs/core v3.5.44 (latest stable; 3.6 still RC)",
      "url": "https://github.com/vuejs/core/releases/tag/v3.5.44",
      "verifiedAt": "2026-10-29"
    },
    {
      "type": "github-examples",
      "label": "Official Vue starter",
      "url": "https://github.com/vuejs/create-vue",
      "verifiedAt": "2026-10-29"
    }
  ],
  "actions": [
    {
      "type": "create_file",
      "templatePath": "templates/package.json.ejs",
      "destination": "package.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/vite.config.ts.ejs",
      "destination": "vite.config.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/tsconfig.json.ejs",
      "destination": "tsconfig.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/tsconfig.node.json.ejs",
      "destination": "tsconfig.node.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/tsconfig.app.json.ejs",
      "destination": "tsconfig.app.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/index.html.ejs",
      "destination": "index.html"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/main.ts.ejs",
      "destination": "src/main.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/App.vue.ejs",
      "destination": "src/App.vue"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/assets/main.css.ejs",
      "destination": "src/assets/main.css"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/stores/counter.ts.ejs",
      "destination": "src/stores/counter.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/style.css.ejs",
      "destination": "src/style.css"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/router/index.ts.ejs",
      "destination": "src/router/index.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/stores/index.ts.ejs",
      "destination": "src/stores/index.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/views/Home/HomeView.vue.ejs",
      "destination": "src/views/Home/HomeView.vue"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/views/About/AboutView.vue.ejs",
      "destination": "src/views/About/AboutView.vue"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.env.example.ejs",
      "destination": ".env.example"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.gitignore.ejs",
      "destination": ".gitignore"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.prettierrc.ejs",
      "destination": ".prettierrc"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.eslintrc.cjs.ejs",
      "destination": ".eslintrc.cjs"
    },
    {
      "type": "create_file",
      "templatePath": "templates/vitest.config.ts.ejs",
      "destination": "vitest.config.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/Dockerfile.ejs",
      "destination": "Dockerfile"
    },
    {
      "type": "create_file",
      "templatePath": "templates/docker-compose.yml.ejs",
      "destination": "docker-compose.yml"
    },
    {
      "type": "create_file",
      "templatePath": "templates/README.md.ejs",
      "destination": "README.md"
    },
    {
      "type": "create_file",
      "templatePath": "templates/github-workflows-ci.yml.ejs",
      "destination": ".github/workflows/ci.yml"
    }
  ],
  "compatibility": {
    "vue": ">=3 <4"
  },
  "status": "stable"
}
