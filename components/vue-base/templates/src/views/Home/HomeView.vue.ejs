<template>
  <section class="container">
    <h1>Welcome to {{ appName }}</h1>
    <p>Generated by BotKelp from the vue-base component.</p>
    <div class="counter">
      <p>Count: {{ counter.count }} (double: {{ counter.doubleCount }})</p>
      <button type="button" @click="counter.increment()">Increment</button>
      <button type="button" @click="counter.reset()">Reset</button>
    </div>
  </section>
</template>

<script lang="ts">
import { defineComponent } from 'vue';
import { useCounterStore } from '../../stores/counter';

export default defineComponent({
  name: 'HomeView',
  setup() {
    const counter = useCounterStore();
    const appName = import.meta.env.VITE_APP_NAME || '<%= projectName || "Vue App" %>';
    return { counter, appName };
  },
});
</script>
