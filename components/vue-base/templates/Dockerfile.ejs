/**
 * Vue / Vite production image
 *
 * Source: https://vitejs.dev/guide/static-deploy.html
 * Verified: 2026-09-06
 */
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
