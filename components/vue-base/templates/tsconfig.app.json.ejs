/**
 * TypeScript Application Configuration for Vue
 * 
 * This file configures TypeScript for the application code.
 * 
 * Source: https://vuejs.org/guide/typescript/overview.html
 * Verified: 2026-09-06
 */

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "noEmit": false,
    "declaration": false,
    "sourceMap": true
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["node_modules", "dist"]
}
