{
  "id": "django-base",
  "name": "Django Base",
  "version": "1.0.1",
  "description": "Django backend project with Python 3.11+. Provides a foundation for Django applications with models, views, URLs, and settings. Includes Docker configuration for PostgreSQL. Packages pinned to Django==5.0.0 (verified 2026-09-06).",
  "requires": [],
  "conflictsWith": [
    "nextjs-base",
    "express",
    "nestjs",
    "fastapi-base",
    "laravel-base",
    "aspnet-base"
  ],
  "provides": [
    "backend"
  ],
  "dependencies": [],
  "devDependencies": [],
  "envVariables": [
    "DJANGO_SECRET_KEY",
    "DJANGO_DEBUG",
    "DJANGO_ALLOWED_HOSTS",
    "DATABASE_URL"
  ],
  "sources": [
    {
      "type": "docs",
      "label": "Django official documentation",
      "url": "https://docs.djangoproject.com/en/5.0/",
      "verifiedAt": "2026-09-06"
    },
    {
      "type": "docs",
      "label": "Django getting started guide",
      "url": "https://docs.djangoproject.com/en/5.0/intro/tutorial01/",
      "verifiedAt": "2026-09-06"
    },
    {
      "type": "github-releases",
      "label": "django/django 5.0",
      "url": "https://github.com/django/django/releases/tag/5.0",
      "verifiedAt": "2026-09-06"
    },
    {
      "type": "github-examples",
      "label": "Official Django project template",
      "url": "https://github.com/django/django/tree/5.0/django/conf/project_template",
      "verifiedAt": "2026-09-06"
    }
  ],
  "actions": [
    {
      "type": "create_file",
      "templatePath": "templates/requirements.txt.ejs",
      "destination": "requirements.txt"
    },
    {
      "type": "create_file",
      "templatePath": "templates/requirements-dev.txt.ejs",
      "destination": "requirements-dev.txt"
    },
    {
      "type": "create_file",
      "templatePath": "templates/manage.py.ejs",
      "destination": "manage.py"
    },
    {
      "type": "create_file",
      "templatePath": "templates/myproject/settings.py.ejs",
      "destination": "myproject/settings.py"
    },
    {
      "type": "create_file",
      "templatePath": "templates/myproject/urls.py.ejs",
      "destination": "myproject/urls.py"
    },
    {
      "type": "create_file",
      "templatePath": "templates/myproject/wsgi.py.ejs",
      "destination": "myproject/wsgi.py"
    },
    {
      "type": "create_file",
      "templatePath": "templates/myproject/asgi.py.ejs",
      "destination": "myproject/asgi.py"
    },
    {
      "type": "create_file",
      "templatePath": "templates/myapp/models.py.ejs",
      "destination": "myapp/models.py"
    },
    {
      "type": "create_file",
      "templatePath": "templates/myapp/views.py.ejs",
      "destination": "myapp/views.py"
    },
    {
      "type": "create_file",
      "templatePath": "templates/myapp/urls.py.ejs",
      "destination": "myapp/urls.py"
    },
    {
      "type": "create_file",
      "templatePath": "templates/myapp/apps.py.ejs",
      "destination": "myapp/apps.py"
    },
    {
      "type": "create_file",
      "templatePath": "templates/myapp/admin.py.ejs",
      "destination": "myapp/admin.py"
    },
    {
      "type": "create_file",
      "templatePath": "templates/Dockerfile.ejs",
      "destination": "Dockerfile"
    },
    {
      "type": "create_file",
      "templatePath": "templates/docker-compose.yml.ejs",
      "destination": "docker-compose.yml"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.env.example.ejs",
      "destination": ".env.example"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.gitignore.ejs",
      "destination": ".gitignore"
    },
    {
      "type": "create_file",
      "templatePath": "templates/README.md.ejs",
      "destination": "README.md"
    },
    {
      "type": "create_file",
      "templatePath": "templates/github-workflows-ci.yml.ejs",
      "destination": ".github/workflows/ci.yml"
    }
  ],
  "compatibility": {
    "django": ">=5 <6",
    "python": ">=3.11"
  },
  "status": "stable"
}
