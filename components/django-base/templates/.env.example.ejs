/**
 * Django Environment Variables Example
 * 
 * Copy this file to .env and update the values for your environment.
 * 
 * Source: https://docs.djangoproject.com/en/5.0/howto/deployment/checklist/
 * Verified: 2026-09-06
 */

# Django secret key (generate a new one for production)
# Use: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production

# Django debug mode
DJANGO_DEBUG=True

# Allowed hosts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL (PostgreSQL format: postgres://user:password@host:port/database)
# For SQLite (default): sqlite:///db.sqlite3
DATABASE_URL=sqlite:///db.sqlite3

# API base path
API_BASE_PATH=/api

# PostgreSQL credentials (if using PostgreSQL)
POSTGRES_USER=django
POSTGRES_PASSWORD=django
POSTGRES_DB=djangodb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis URL (optional, for caching)
REDIS_URL=redis://redis:6379/0

# CORS settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# Logging level
DJANGO_LOG_LEVEL=INFO
