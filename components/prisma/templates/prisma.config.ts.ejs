import { config as loadEnv } from 'dotenv';
import { defineConfig, env } from 'prisma/config';

/**
 * Prisma 7 moved the database connection string out of schema.prisma and
 * stopped auto-loading .env files — see
 * https://pris.ly/d/prisma7-client-config. This file is read by the Prisma
 * CLI (generate/migrate/studio) only, not bundled into the Next.js app.
 *
 * Loaded in the same order/precedence Next.js itself uses, so DATABASE_URL
 * resolves the same way here as it does for the running app: .env first,
 * then .env.local overriding it.
 */
loadEnv({ path: '.env' });
loadEnv({ path: '.env.local', override: true });
export default defineConfig({
  schema: './prisma/schema.prisma',
  datasource: {
    url: env('DATABASE_URL'),
  },
});
