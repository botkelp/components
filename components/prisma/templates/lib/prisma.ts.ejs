import { PrismaClient } from '@prisma/client';
import { PrismaPg } from '@prisma/adapter-pg';

/**
 * Hot-reload-safe singleton: Next.js dev mode re-executes this module on
 * every edit, and a fresh PrismaClient per reload exhausts Postgres'
 * connection limit within minutes. Caching the instance on `globalThis`
 * (untouched across reloads, unlike a module-local variable) avoids that.
 * Not cached in production, where each server instance should own its own
 * client for the life of the process.
 *
 * Prisma 7 requires an explicit driver adapter (no more implicit
 * schema-driven connections) — see https://pris.ly/d/prisma7-client-config.
 * On a serverless platform (e.g. Vercel), a connection-pooled DATABASE_URL
 * (Supabase's pooler, or Prisma Accelerate) is strongly recommended — each
 * concurrently invoked function instance opens its own connection.
 */
const globalForPrisma = globalThis as unknown as { prisma?: PrismaClient };

const adapter = new PrismaPg({ connectionString: process.env.DATABASE_URL! });

export const prisma = globalForPrisma.prisma ?? new PrismaClient({ adapter });

if (process.env.NODE_ENV !== 'production') {
  globalForPrisma.prisma = prisma;
}
