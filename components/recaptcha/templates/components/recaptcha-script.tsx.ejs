'use client';

import { useEffect } from 'react';

/**
 * reCAPTCHA Script component.
 * 
 * This component loads the Google reCAPTCHA script asynchronously.
 * It should be placed at the root of your application (e.g., in layout.tsx).
 * 
 * Usage:
 * import { ReCaptchaScript } from '@/components/recaptcha-script';
 * 
 * function RootLayout({ children }: { children: React.ReactNode }) {
 *   return (
 *     <html>
 *       <head>
 *         <ReCaptchaScript />
 *       </head>
 *       <body>{children}</body>
 *     </html>
 *   );
 * }
 * 
 * See: https://developers.google.com/recaptcha/docs/display
 */
export function ReCaptchaScript({
  siteKey,
  version = 'v3',
  onLoad,
}: {
  siteKey?: string;
  version?: 'v2' | 'v3' | 'v2_invisible';
  onLoad?: () => void;
}) {
  const resolvedSiteKey = siteKey || process.env.NEXT_PUBLIC_RECAPTCHA_SITE_KEY;

  useEffect(() => {
    if (!resolvedSiteKey) {
      console.warn('reCAPTCHA site key is not configured');
      return;
    }

    // Check if script is already loaded
    if (document.getElementById('recaptcha-script')) {
      if (onLoad) onLoad();
      return;
    }

    const script = document.createElement('script');
    script.id = 'recaptcha-script';
    script.src = `https://www.google.com/recaptcha/api.js?render=${resolvedSiteKey}`;
    script.async = true;
    script.defer = true;

    script.onload = () => {
      // @ts-ignore - grecaptcha is a global object
      if (typeof window.grecaptcha !== 'undefined') {
        // Initialize reCAPTCHA
        // @ts-ignore
        window.grecaptcha.ready(() => {
          if (onLoad) onLoad();
        });
      } else if (onLoad) {
        onLoad();
      }
    };

    script.onerror = () => {
      console.error('Failed to load reCAPTCHA script');
    };

    document.head.appendChild(script);

    return () => {
      // Cleanup: remove script if component unmounts
      const existingScript = document.getElementById('recaptcha-script');
      if (existingScript) {
        document.head.removeChild(existingScript);
      }
    };
  }, [resolvedSiteKey, onLoad]);

  return null;
}

export default ReCaptchaScript;
