# Prisma documented form (verified 2026-09-06):
# https://www.prisma.io/docs/prisma-orm/quickstart/postgresql
#   postgresql://username:password@host:5432/database?sslmode=require
# Local Docker (see docker-compose.yml, official image postgres:18):
# https://hub.docker.com/_/postgres

POSTGRES_USER=<%= projectName.replace(/[^a-zA-Z0-9]/g, '') || 'app' %>
POSTGRES_PASSWORD=postgres
POSTGRES_DB=<%= projectName.replace(/[^a-zA-Z0-9]/g, '') || 'app' %>
DATABASE_URL=postgresql://<%= projectName.replace(/[^a-zA-Z0-9]/g, '') || 'app' %>:postgres@localhost:5432/<%= projectName.replace(/[^a-zA-Z0-9]/g, '') || 'app' %>
