/**
 * Core.js polyfill initialization.
 * Official namespaces: https://github.com/zloirock/core-js#readme
 * Profile: <%= typeof profile !== 'undefined' ? profile : 'minimal' %>
 *
 * `core-js/stable` already includes Promise, Array, Object, String, Map/Set.
 * Extra per-feature imports only ship when profile=complete.
 */

import 'core-js/stable';
<% if (typeof minimal === 'undefined' || minimal === false) { %>
import 'core-js/features/promise';
import 'core-js/features/array/includes';
import 'core-js/features/array/find';
import 'core-js/features/array/find-index';
import 'core-js/features/array/filter';
import 'core-js/features/array/map';
import 'core-js/features/array/reduce';
import 'core-js/features/array/for-each';
import 'core-js/features/object/assign';
import 'core-js/features/object/entries';
import 'core-js/features/object/values';
import 'core-js/features/object/keys';
import 'core-js/features/string/includes';
import 'core-js/features/string/starts-with';
import 'core-js/features/string/ends-with';
import 'core-js/features/string/repeat';
import 'core-js/features/string/pad-start';
import 'core-js/features/string/pad-end';
import 'core-js/features/string/trim-start';
import 'core-js/features/string/trim-end';
import 'core-js/features/number/is-nan';
import 'core-js/features/number/is-finite';
import 'core-js/features/number/parse-int';
import 'core-js/features/number/parse-float';
import 'core-js/features/math/sign';
import 'core-js/features/math/trunc';
import 'core-js/features/set';
import 'core-js/features/map';
import 'core-js/features/weak-set';
import 'core-js/features/weak-map';
<% } %>
