/**
 * TypeScript declarations for Day.js usage in the project.
 * 
 * This file provides type extensions and custom type definitions
 * for Day.js when used with plugins.
 */

import dayjs from 'dayjs';

// Extend Day.js with custom plugins
declare module 'dayjs' {
  interface Dayjs {
    // UTC plugin
    utc(): Dayjs;
    local(): Dayjs;
    
    // Timezone plugin
    tz(timezone: string): Dayjs;
    
    // Duration plugin
    static duration(value: number, unit?: dayjs.OpUnitType): dayjs.Duration;
    
    // RelativeTime plugin
    fromNow(withoutSuffix?: boolean): string;
    from(date: dayjs.ConfigType, withoutSuffix?: boolean): string;
    toNow(withoutSuffix?: boolean): string;
    to(date: dayjs.ConfigType, withoutSuffix?: boolean): string;
    
    // AdvancedFormat plugin
    format(template: string): string;
    
    // CustomParseFormat plugin
    static isDayjs(d: any): boolean;
    
    // isBetween plugin
    isBetween(start: dayjs.ConfigType, end: dayjs.ConfigType, granularity?: dayjs.OpUnitType, inclusivity?: '()' | '(]' | '[)' | '[]'): boolean;
    
    // isSameOrBefore plugin
    isSameOrBefore(date: dayjs.ConfigType, unit?: dayjs.OpUnitType): boolean;
    
    // isSameOrAfter plugin
    isSameOrAfter(date: dayjs.ConfigType, unit?: dayjs.OpUnitType): boolean;
  }
  
  interface Duration {
    as(unit: dayjs.OpUnitType): number;
    asSeconds(): number;
    asMinutes(): number;
    asHours(): number;
    asDays(): number;
    asWeeks(): number;
    asMonths(): number;
    asYears(): number;
    asMilliseconds(): number;
    add(value: number, unit: dayjs.OpUnitType): Duration;
    subtract(value: number, unit: dayjs.OpUnitType): Duration;
    humanize(withSuffix?: boolean): string;
  }
}
