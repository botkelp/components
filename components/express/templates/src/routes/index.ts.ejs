// API documentation endpoint
router.get('/docs', (req, res) => {
  res.status(200).json({
    name: '<%= projectName || 'Express API' %>',
    version: '1.0.0',
    description: 'Express.js backend server generated by BotKelp',
    endpoints: {
      health: {
        get: '/health - Health check endpoint',
      },
    },
  });
});

export default router;
