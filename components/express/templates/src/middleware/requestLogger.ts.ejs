/**
 * Express Request Logger Middleware
 * 
 * This middleware logs incoming requests for debugging purposes.
 * 
 * Source: https://expressjs.com/en/guide/writing-middleware.html
 * Verified: 2026-09-06
 */

import { Request, Response, NextFunction } from 'express';
import { config } from '../config';

// Request logging middleware
export function requestLogger(
  req: Request,
  res: Response,
  next: NextFunction
) {
  // Only log in development or if explicitly enabled
  if (config.NODE_ENV === 'development' || config.REQUEST_LOGGING) {
    const start = Date.now();

    // Log request start
    console.log(`[${new Date().toISOString()}] Incoming request:`, {
      method: req.method,
      path: req.path,
      query: req.query,
      headers: {
        'user-agent': req.headers['user-agent'],
        'content-type': req.headers['content-type'],
        'content-length': req.headers['content-length'],
        'x-forwarded-for': req.headers['x-forwarded-for'],
      },
      body: req.body && Object.keys(req.body).length > 0 ? req.body : undefined,
    });

    // Hook into response finish event
    res.on('finish', () => {
      const duration = Date.now() - start;
      console.log(`[${new Date().toISOString()}] Request completed:`, {
        method: req.method,
        path: req.path,
        statusCode: res.statusCode,
        duration: `${duration}ms`,
        contentLength: res.getHeader('content-length'),
      });
    });

    res.on('close', () => {
      const duration = Date.now() - start;
      console.log(`[${new Date().toISOString()}] Request closed:`, {
        method: req.method,
        path: req.path,
        duration: `${duration}ms`,
      });
    });
  }

  next();
}
