## Monitoring and Logging

### Structured Logging

Use structured logging with a library like `pino`:

```bash
npm install pino pino-http
```

```typescript
// src/middleware/logger.ts
import pino from 'pino';
import { IncomingMessage, ServerResponse } from 'http';

const logger = pino({
  level: process.env.LOG_LEVEL || 'info',
  formatters: {
    level: (label) => ({ level: label }),
    log: (object) => ({
      ...object,
      timestamp: new Date().toISOString(),
    }),
  },
});

export function pinoLogger(req: IncomingMessage, res: ServerResponse) {
  req.log = logger.child({ req });
  res.log = logger.child({ res });
  
  // Log request start
  req.log.info({ msg: 'Incoming request' });
  
  // Log response finish
  res.on('finish', () => {
    res.log.info({ msg: 'Request completed', statusCode: res.statusCode });
  });
}
```

### Winston

Install Winston:

```bash
npm install winston winston-daily-rotate-file
```

```typescript
// src/middleware/logger.ts
import winston from 'winston';
import DailyRotateFile from 'winston-daily-rotate-file';

const logger = winston.createLogger({
  level: process.env.LOG_LEVEL || 'info',
  format: winston.format.combine(
    winston.format.timestamp(),
    winston.format.json()
  ),
  transports: [
    new winston.transports.Console({
      format: winston.format.combine(
        winston.format.colorize(),
        winston.format.simple()
      ),
    }),
    new DailyRotateFile({
      filename: 'logs/application-%DATE%.log',
      datePattern: 'YYYY-MM-DD',
      maxSize: '20m',
      maxFiles: '14d',
    }),
  ],
});

export function winstonLogger(req: Request, res: Response, next: NextFunction) {
  logger.info(`${req.method} ${req.path}`, {
    method: req.method,
    path: req.path,
    query: req.query,
    headers: req.headers,
  });
  
  res.on('finish', () => {
    logger.info(`${req.method} ${req.path} ${res.statusCode}`, {
      statusCode: res.statusCode,
      duration: res.getHeader('X-Response-Time'),
    });
  });
  
  next();
}
```

