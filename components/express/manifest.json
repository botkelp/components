{
  "id": "express",
  "name": "Express Backend",
  "version": "1.0.0",
  "description": "Express.js backend server with TypeScript. Provides a REST API foundation with middleware support, error handling, and environment configuration. Packages pinned to express@4.18.0, @types/express@4.17.0 (verified 2026-09-06).",
  "requires": [],
  "conflictsWith": ["nextjs-base", "nestjs", "django-base", "fastapi-base", "laravel-base", "aspnet-base"],
  "provides": ["backend"],
  "dependencies": ["express", "cors", "dotenv", "helmet", "morgan"],
  "devDependencies": [
    "@types/cors",
    "@types/express",
    "@types/morgan",
    "@types/node",
    "typescript",
    "ts-node",
    "nodemon"
  ],
  "envVariables": ["NODE_ENV", "PORT", "API_BASE_PATH"],
  "sources": [
    {
      "type": "docs",
      "label": "Express.js official documentation",
      "url": "https://expressjs.com/en/starter/installing.html",
      "verifiedAt": "2026-09-06"
    },
    {
      "type": "docs",
      "label": "Express TypeScript guide",
      "url": "https://expressjs.com/en/advanced/developing-template-engines.html",
      "verifiedAt": "2026-09-06"
    },
    {
      "type": "github-releases",
      "label": "expressjs/express v4.18.0",
      "url": "https://github.com/expressjs/express/releases/tag/v4.18.0",
      "verifiedAt": "2026-09-06"
    },
    {
      "type": "github-examples",
      "label": "Express TypeScript starter",
      "url": "https://github.com/expressjs/express/tree/v4.18.0/examples/typescript",
      "verifiedAt": "2026-09-06"
    }
  ],
  "actions": [
    {
      "type": "create_file",
      "templatePath": "templates/package.json.ejs",
      "destination": "package.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/tsconfig.json.ejs",
      "destination": "tsconfig.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/server.ts.ejs",
      "destination": "src/server.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/routes/index.ts.ejs",
      "destination": "src/routes/index.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/routes/health.ts.ejs",
      "destination": "src/routes/health.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/middleware/errorHandler.ts.ejs",
      "destination": "src/middleware/errorHandler.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/middleware/requestLogger.ts.ejs",
      "destination": "src/middleware/requestLogger.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/config/index.ts.ejs",
      "destination": "src/config/index.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.env.example.ejs",
      "destination": ".env.example"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.gitignore.ejs",
      "destination": ".gitignore"
    },
    {
      "type": "create_file",
      "templatePath": "templates/Dockerfile.ejs",
      "destination": "Dockerfile"
    },
    {
      "type": "create_file",
      "templatePath": "templates/docker-compose.yml.ejs",
      "destination": "docker-compose.yml"
    },
    {
      "type": "create_file",
      "templatePath": "templates/README.md.ejs",
      "destination": "README.md"
    }
  ]
}
