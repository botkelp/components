# FastAPI environment variables.
# Copy this file to .env and update the values for your environment.
# Source: https://fastapi.tiangolo.com/advanced/settings/

# Application info
APP_NAME=<%= projectName || 'FastAPI App' %>
APP_VERSION=1.0.0

# Environment
ENVIRONMENT=development
DEBUG=True

# Security
# Generate a new secret key: openssl rand -hex 32
SECRET_KEY=change-this-in-production-use-openssl-rand-hex-32

# API
API_V1_PREFIX=/api/v1

# Database URL
# SQLite (default): sqlite:///./sql_app.db
# PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/database
DATABASE_URL=sqlite:///./sql_app.db

# PostgreSQL credentials (if using PostgreSQL)
POSTGRES_USER=fastapi
POSTGRES_PASSWORD=fastapi
POSTGRES_DB=fastapidb
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080
CORS_ORIGIN_REGEX=

# Logging
LOG_LEVEL=INFO
