"""
Application Configuration

This module contains all application configuration settings.

Source: https://fastapi.tiangolo.com/tutorial/dependencies/
Verified: 2026-09-06
"""

from typing import Annotated, List, Optional

from pydantic import field_validator
from pydantic_settings import BaseSettings, NoDecode, SettingsConfigDict


class Settings(BaseSettings):
    """
    Application settings loaded from environment variables and `.env`.

    Every field can be overridden by an environment variable of the same name.
    Unknown keys in `.env` (for example POSTGRES_* for docker-compose) are ignored.
    """

    model_config = SettingsConfigDict(
        env_file=".env",
        env_file_encoding="utf-8",
        case_sensitive=True,
        extra="ignore",
    )

    # Application info
    APP_NAME: str = "<%= projectName || 'FastAPI App' %>"
    APP_VERSION: str = "1.0.0"

    # Environment
    ENVIRONMENT: str = "development"
    DEBUG: bool = True

    # Security
    SECRET_KEY: str = "change-this-in-production"

    # API
    API_V1_PREFIX: str = "/api/v1"

    # CORS: a comma-separated string in env/.env, e.g. "http://a.com,http://b.com".
    # NoDecode stops pydantic-settings from JSON-decoding it before the validator runs.
    CORS_ORIGINS: Annotated[List[str], NoDecode] = [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "http://localhost:8080",
    ]
    CORS_ORIGIN_REGEX: Optional[str] = None

    # Database
    DATABASE_URL: str = "sqlite:///./sql_app.db"

    # Server
    SERVER_HOST: str = "0.0.0.0"
    SERVER_PORT: int = 8000

    # Logging
    LOG_LEVEL: str = "INFO"

    @field_validator("CORS_ORIGINS", mode="before")
    @classmethod
    def _split_cors_origins(cls, value):
        if isinstance(value, str):
            value = value.strip()
            if value.startswith("["):
                import json

                return json.loads(value)
            return [origin.strip() for origin in value.split(",") if origin.strip()]
        return value

    @field_validator("CORS_ORIGIN_REGEX", mode="before")
    @classmethod
    def _empty_regex_is_none(cls, value):
        return value or None


# Create settings instance
settings = Settings()
