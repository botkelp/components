"""
Example Endpoints

This module provides example CRUD endpoints for demonstration purposes.

Source: https://fastapi.tiangolo.com/tutorial/first-steps/
Verified: 2026-09-06
"""

from datetime import datetime
from typing import List, Optional
from fastapi import APIRouter, Depends, HTTPException, status
from pydantic import BaseModel, Field
from uuid import UUID, uuid4

# Create router for example endpoints
router = APIRouter(prefix="/examples", tags=["examples"])


# Pydantic models
class ExampleBase(BaseModel):
    """Base model for Example with common fields."""
    name: str = Field(..., min_length=1, max_length=255, description="Name of the example")
    description: Optional[str] = Field(None, max_length=1000, description="Description of the example")
    count: int = Field(0, ge=0, le=1000, description="Count value")
    is_active: bool = Field(True, description="Whether the example is active")


class ExampleCreate(ExampleBase):
    """Model for creating a new Example."""
    pass


class ExampleUpdate(BaseModel):
    """Model for updating an Example."""
    name: Optional[str] = Field(None, min_length=1, max_length=255)
    description: Optional[str] = Field(None, max_length=1000)
    count: Optional[int] = Field(None, ge=0, le=1000)
    is_active: Optional[bool] = Field(None)


class ExampleResponse(ExampleBase):
    """Model for Example response with additional fields."""
    id: UUID
    created_at: datetime
    updated_at: datetime
    
    class Config:
        from_attributes = True


# In-memory storage for examples (replace with database in production)
examples_db = {}


# Helper functions
def get_example_by_id(example_id: UUID):
    """Get an example by ID from the in-memory database."""
    if example_id not in examples_db:
        raise HTTPException(
            status_code=status.HTTP_404_NOT_FOUND,
            detail=f"Example with id {example_id} not found"
        )
    return examples_db[example_id]


# CRUD Endpoints
@router.get("/", summary="List Examples", response_model=List[ExampleResponse])
async def list_examples(
    skip: int = 0,
    limit: int = 100,
    is_active: Optional[bool] = None,
):
    """
    List all examples with optional filtering and pagination.
    
    Parameters:
    - skip: Number of items to skip (for pagination)
    - limit: Maximum number of items to return
    - is_active: Filter by active status
    """
    examples = list(examples_db.values())
    
    # Filter by active status if specified
    if is_active is not None:
        examples = [e for e in examples if e.is_active == is_active]
    
    # Apply pagination
    start = skip
    end = skip + limit
    
    return examples[start:end]


@router.post("/", summary="Create Example", response_model=ExampleResponse, status_code=status.HTTP_201_CREATED)
async def create_example(example: ExampleCreate):
    """
    Create a new example.
    
    Returns the created example with its ID.
    """
    example_id = uuid4()
    now = datetime.utcnow()
    
    new_example = ExampleResponse(
        id=example_id,
        name=example.name,
        description=example.description,
        count=example.count,
        is_active=example.is_active,
        created_at=now,
        updated_at=now,
    )
    
    examples_db[example_id] = new_example
    
    return new_example


@router.get("/{example_id}", summary="Get Example", response_model=ExampleResponse)
async def read_example(example_id: UUID):
    """
    Get a specific example by ID.
    
    Returns the example details or 404 if not found.
    """
    return get_example_by_id(example_id)


@router.put("/{example_id}", summary="Update Example", response_model=ExampleResponse)
async def update_example(
    example_id: UUID,
    example: ExampleUpdate,
):
    """
    Update an existing example by ID.
    
    Returns the updated example or 404 if not found.
    """
    existing_example = get_example_by_id(example_id)
    
    # Update fields
    update_data = example.model_dump(exclude_unset=True)
    for field, value in update_data.items():
        setattr(existing_example, field, value)
    
    # Update the timestamp
    existing_example.updated_at = datetime.utcnow()
    
    # Save back to database
    examples_db[example_id] = existing_example
    
    return existing_example


@router.delete("/{example_id}", summary="Delete Example", status_code=status.HTTP_204_NO_CONTENT)
async def delete_example(example_id: UUID):
    """
    Delete an example by ID.
    
    Returns 204 No Content on success or 404 if not found.
    """
    get_example_by_id(example_id)
    del examples_db[example_id]
    return None


@router.patch("/{example_id}/toggle", summary="Toggle Example Active Status", response_model=ExampleResponse)
async def toggle_example_active(example_id: UUID):
    """
    Toggle the active status of an example.
    
    Returns the updated example with toggled is_active field.
    """
    existing_example = get_example_by_id(example_id)
    existing_example.is_active = not existing_example.is_active
    existing_example.updated_at = datetime.utcnow()
    
    examples_db[example_id] = existing_example
    
    return existing_example
