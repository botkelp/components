name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

# Least-privilege GITHUB_TOKEN. This workflow only installs dependencies and
# builds; it never writes to the repository. Without this block the job
# inherits the repository-default token scopes, which on many repositories
# include write access — handed to `npm install`, which executes arbitrary
# lifecycle scripts from the whole dependency tree.
permissions:
  contents: read

jobs:
  build:
    name: Install and build
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: pip install -r requirements.txt
      - run: python -c "from app.core.config import settings; print('Config OK')"
