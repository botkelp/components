name: CI

on:
  push:
    branches: [main]
  pull_request:
  workflow_dispatch:

# Least-privilege GITHUB_TOKEN: this workflow only installs and tests.
permissions:
  contents: read

jobs:
  test:
    name: Install and test (Python ${{ matrix.python-version }})
    runs-on: ubuntu-latest
    timeout-minutes: 15
    strategy:
      fail-fast: false
      matrix:
        python-version: ['3.11', '3.13']
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: Use .env.example so the app boots with its real config file
        run: cp .env.example .env
      - run: pip install -r requirements-dev.txt
      - run: python -c "from app.core.config import settings; print('Config OK')"
      - run: pytest -q
