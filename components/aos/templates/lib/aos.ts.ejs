/**
 * AOS (Animate On Scroll) configuration utilities.
 * 
 * This module exports AOS configuration and helper functions
 * for use in Next.js applications.
 * 
 * See: https://michalsnik.github.io/aos/
 */

// @ts-ignore - aos doesn't have TypeScript types, using our custom declarations
import AOS from 'aos';
import 'aos/dist/aos.css';

// AOS Options interface (mirrors our type declaration)
interface AOSOptions {
  offset?: number;
  duration?: number;
  easing?: string;
  delay?: number;
  disable?: boolean | string;
  startEvent?: string;
  initClassName?: string;
  animatedClassName?: string;
  useClassNames?: boolean;
  disableMutationObserver?: boolean;
  debounceDelay?: number;
  throttleDelay?: number;
}

// Default AOS configuration
export const defaultAOSOptions: AOSOptions = {
  offset: 100,
  duration: 400,
  easing: 'ease',
  delay: 0,
  disable: false,
  startEvent: 'DOMContentLoaded',
  initClassName: 'aos-init',
  animatedClassName: 'aos-animate',
  disableMutationObserver: false,
  debounceDelay: 50,
  throttleDelay: 99,
};

// Initialize AOS with custom options
export const initAOS = (options: AOSOptions = {}) => {
  const mergedOptions = {
    ...defaultAOSOptions,
    ...options,
  };
  AOS.init(mergedOptions);
};

// Refresh AOS (useful after dynamic content changes)
export const refreshAOS = () => {
  AOS.refresh();
};

// Refresh AOS hard (recalculates all elements)
export const refreshAOSHard = () => {
  AOS.refreshHard();
};

export { AOS };
export type { AOSOptions };
