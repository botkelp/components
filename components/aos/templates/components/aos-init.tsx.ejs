'use client';

import { useEffect } from 'react';
import { initAOS, refreshAOS } from '@/lib/aos';

/**
 * AOS Initialization component.
 * 
 * This component initializes AOS (Animate On Scroll) when mounted.
 * It should be placed at the root of your application (e.g., in layout.tsx).
 * 
 * Usage:
 * import { AOSInit } from '@/components/aos-init';
 * 
 * function RootLayout({ children }: { children: React.ReactNode }) {
 *   return (
 *     <html>
 *       <body>
 *         <AOSInit />
 *         {children}
 *       </body>
 *     </html>
 *   );
 * }
 * 
 * See: https://michalsnik.github.io/aos/
 */
export function AOSInit({
  options = {},
}: {
  options?: {
    offset?: number;
    duration?: number;
    easing?: string;
    delay?: number;
    disable?: boolean | string;
  };
}) {
  useEffect(() => {
    // Initialize AOS
    initAOS(options);

    // Refresh AOS on window resize
    const handleResize = () => {
      refreshAOS();
    };

    window.addEventListener('resize', handleResize);

    // Cleanup
    return () => {
      window.removeEventListener('resize', handleResize);
    };
  }, [options]);

  return null;
}
