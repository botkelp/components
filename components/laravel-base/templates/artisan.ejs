#!/usr/bin/env php
<?php

/**
 * Laravel Artisan CLI Entry Point
 * 
 * This is the entry point for Laravel's command-line interface.
 * 
 * Source: https://laravel.com/docs/11.x/artisan
 * Verified: 2026-09-06
 */

use Symfony\Component\Console\Input\ArgvInput;

define('LARAVEL_START', microtime(true));

// Register the Composer autoloader...
require __DIR__.'/vendor/autoload.php';

// Bootstrap Laravel and handle the command...
$status = \Illuminate\\Foundation\\Application::handleCommand(new ArgvInput);

exit($status);
