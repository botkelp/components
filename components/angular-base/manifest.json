{
  "id": "angular-base",
  "name": "Angular Base",
  "version": "2.0.0",
  "description": "Minimal Angular 22 application with Angular CLI, TypeScript, and RxJS. Packages pinned to @angular/core@22.2.3, @angular/cli@22.2.5.",
  "requires": [],
  "conflictsWith": [
    "nextjs-base",
    "vue-base",
    "svelte-base"
  ],
  "provides": [
    "framework"
  ],
  "dependencies": [
    "@angular/animations",
    "@angular/common",
    "@angular/compiler",
    "@angular/core",
    "@angular/forms",
    "@angular/platform-browser",
    "@angular/platform-browser-dynamic",
    "@angular/router",
    "rxjs",
    "tslib",
    "zone.js"
  ],
  "devDependencies": [
    "@angular/cli",
    "@angular-devkit/build-angular",
    "@angular/compiler-cli",
    "@types/jasmine",
    "@types/node",
    "jasmine-core",
    "karma",
    "karma-chrome-launcher",
    "karma-coverage",
    "karma-jasmine",
    "karma-jasmine-html-reporter",
    "typescript"
  ],
  "envVariables": [],
  "sources": [
    {
      "type": "docs",
      "label": "Angular update guide (v18 to v22 path)",
      "url": "https://angular.dev/update-guide",
      "verifiedAt": "2026-10-29"
    },
    {
      "type": "github-releases",
      "label": "angular/angular v22.2.3",
      "url": "https://github.com/angular/angular/releases/tag/v22.2.3",
      "verifiedAt": "2026-10-29"
    },
    {
      "type": "github-examples",
      "label": "Official Angular CLI v22.2.x",
      "url": "https://github.com/angular/angular-cli/releases/tag/v22.2.5",
      "verifiedAt": "2026-10-29"
    }
  ],
  "actions": [
    {
      "type": "create_file",
      "templatePath": "templates/package.json.ejs",
      "destination": "package.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/angular.json.ejs",
      "destination": "angular.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/tsconfig.json.ejs",
      "destination": "tsconfig.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/tsconfig.app.json.ejs",
      "destination": "tsconfig.app.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/tsconfig.spec.json.ejs",
      "destination": "tsconfig.spec.json"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/index.html.ejs",
      "destination": "src/index.html"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/main.ts.ejs",
      "destination": "src/main.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/styles.css.ejs",
      "destination": "src/styles.css"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app/app.component.ts.ejs",
      "destination": "src/app/app.component.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app/app.component.html.ejs",
      "destination": "src/app/app.component.html"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app/app.component.css.ejs",
      "destination": "src/app/app.component.css"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app/pages/home/home.page.ts.ejs",
      "destination": "src/app/pages/home/home.page.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app/pages/home/home.page.html.ejs",
      "destination": "src/app/pages/home/home.page.html"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app/pages/home/home.page.css.ejs",
      "destination": "src/app/pages/home/home.page.css"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app/pages/about/about.page.ts.ejs",
      "destination": "src/app/pages/about/about.page.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app/pages/about/about.page.html.ejs",
      "destination": "src/app/pages/about/about.page.html"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app/pages/about/about.page.css.ejs",
      "destination": "src/app/pages/about/about.page.css"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app/app.config.ts.ejs",
      "destination": "src/app/app.config.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/app/app.routes.ts.ejs",
      "destination": "src/app/app.routes.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/environments/environment.ts.ejs",
      "destination": "src/environments/environment.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/src/environments/environment.prod.ts.ejs",
      "destination": "src/environments/environment.prod.ts"
    },
    {
      "type": "create_file",
      "templatePath": "templates/README.md.ejs",
      "destination": "README.md"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.gitignore.ejs",
      "destination": ".gitignore"
    },
    {
      "type": "create_file",
      "templatePath": "templates/.browserslistrc.ejs",
      "destination": ".browserslistrc"
    },
    {
      "type": "create_file",
      "templatePath": "templates/github-workflows-ci.yml.ejs",
      "destination": ".github/workflows/ci.yml"
    }
  ],
  "compatibility": {
    "angular": ">=22 <23"
  },
  "status": "stable"
}
