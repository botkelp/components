## Performance Optimization

### Lazy Loading

Lazy load modules to improve initial load time:

```typescript
// app.routes.ts
import { Routes } from '@angular/router';

export const routes: Routes = [
  {
    path: '',
    loadComponent: () => import('./pages/home/home.page').then(m => m.HomePage),
  },
  {
    path: 'about',
    loadComponent: () => import('./pages/about/about.page').then(m => m.AboutPage),
  },
];
```

### OnPush Change Detection

Use OnPush change detection strategy for better performance:

```typescript
import { Component, ChangeDetectionStrategy } from '@angular/core';

@Component({
  selector: 'app-example',
  standalone: true,
  template: '<p>{{ data }}</p>',
  changeDetection: ChangeDetectionStrategy.OnPush,
})
export class ExampleComponent {
  data = 'Example';
}
```

### TrackBy in NgFor

Use `trackBy` in `*ngFor` to optimize rendering:

```html
<div *ngFor="let item of items; trackBy: trackById">
  {{ item.name }}
</div>
```

```typescript
trackById(index: number, item: Item) {
  return item.id;
}
```

### Standalone Components

Use standalone components to reduce bundle size:

```typescript
@Component({
  selector: 'app-example',
  standalone: true,
  imports: [CommonModule],
  template: '<p>Example</p>',
})
export class ExampleComponent {}
```

## Testing

### Unit Testing

Angular uses Jasmine for unit testing:

```typescript
import { ComponentFixture, TestBed } from '@angular/core/testing';
import { ExampleComponent } from './example.component';

describe('ExampleComponent', () => {
  let component: ExampleComponent;
  let fixture: ComponentFixture<ExampleComponent>;

  beforeEach(async () => {
    await TestBed.configureTestingModule({
      imports: [ExampleComponent],
    }).compileComponents();

    fixture = TestBed.createComponent(ExampleComponent);
    component = fixture.componentInstance;
    fixture.detectChanges();
  });

  it('should create', () => {
    expect(component).toBeTruthy();
  });

  it('should have correct title', () => {
    expect(component.title).toBe('Example');
  });
});
```

### Component Testing

Test component rendering and behavior:

```typescript
it('should render title', () => {
  const fixture = TestBed.createComponent(ExampleComponent);
  fixture.detectChanges();
  const compiled = fixture.nativeElement as HTMLElement;
  expect(compiled.querySelector('h1')?.textContent).toContain('Example');
});
```

### Service Testing

Test services with TestBed:

```typescript
import { TestBed } from '@angular/core/testing';
import { HttpClientTestingModule } from '@angular/common/http/testing';
import { ExampleService } from './example.service';

describe('ExampleService', () => {
  let service: ExampleService;

  beforeEach(() => {
    TestBed.configureTestingModule({
      imports: [HttpClientTestingModule],
    });
    service = TestBed.inject(ExampleService);
  });

  it('should be created', () => {
    expect(service).toBeTruthy();
  });
});
```

### HTTP Testing

Test HTTP requests with HttpClientTestingModule:

```typescript
import { HttpClientTestingModule, HttpTestingController } from '@angular/common/http/testing';

it('should get data', () => {
  const httpMock = TestBed.inject(HttpTestingController);
  
  service.getData().subscribe(data => {
    expect(data).toEqual(expectedData);
  });
  
  const req = httpMock.expectOne('/api/data');
  expect(req.request.method).toBe('GET');
  req.flush(expectedData);
});
```

## Troubleshooting

### Common Issues

1. **Module not found**: Run `npm install` to install dependencies
2. **TypeScript errors**: Check your `tsconfig.json` configuration
3. **Angular CLI errors**: Update Angular CLI with `npm install -g @angular/cli`
4. **Build errors**: Check the console output for specific error messages
5. **Routing not working**: Ensure your routes are properly configured

### Debugging

```bash
# Run with debug logging
ng serve --verbose

# Inspect TypeScript types
npx tsc --noEmit

# Check Angular version
ng version

# Check Node.js version
node -v

# Check npm version
npm -v
```

### Browser Developer Tools

1. Open browser developer tools (F12)
2. Check the Console tab for errors
3. Check the Network tab for API requests
4. Check the Elements tab for DOM structure
5. Check the Sources tab for debugging

