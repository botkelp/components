## Angular Features

### Components

Angular applications are built using components. Each component consists of:

- **TypeScript class** (`.ts`): Contains the component logic and data
- **HTML template** (`.html`): Defines the component's markup
- **CSS styles** (`.css`): Contains the component's styles
- **Metadata** (`@Component` decorator): Defines the component's configuration

### Standalone Components

Angular 18 introduces standalone components that don't require NgModules:

```typescript
import { Component } from '@angular/core';
import { CommonModule } from '@angular/common';

@Component({
  selector: 'app-example',
  standalone: true,
  imports: [CommonModule],
  template: '<p>Example component</p>',
})
export class ExampleComponent {}
```

### Dependency Injection

Angular's dependency injection system makes it easy to manage dependencies:

```typescript
import { Injectable } from '@angular/core';
import { HttpClient } from '@angular/common/http';

@Injectable({ providedIn: 'root' })
export class ExampleService {
  constructor(private http: HttpClient) {}
  
  getData() {
    return this.http.get('/api/data');
  }
}
```

### Routing

Angular's router enables navigation between different views:

```typescript
import { Routes } from '@angular/router';
import { HomeComponent } from './home/home.component';
import { AboutComponent } from './about/about.component';

export const routes: Routes = [
  { path: '', component: HomeComponent },
  { path: 'about', component: AboutComponent },
  { path: '**', redirectTo: '' },
];
```

### HTTP Client

Angular provides a powerful HTTP client for making API requests:

```typescript
import { HttpClient } from '@angular/common/http';
import { Injectable } from '@angular/core';

@Injectable({ providedIn: 'root' })
export class ApiService {
  constructor(private http: HttpClient) {}
  
  getUsers() {
    return this.http.get<User[]>('/api/users');
  }
  
  createUser(user: User) {
    return this.http.post<User>('/api/users', user);
  }
  
  updateUser(id: number, user: User) {
    return this.http.put<User>(`/api/users/${id}`, user);
  }
  
  deleteUser(id: number) {
    return this.http.delete(`/api/users/${id}`);
  }
}
```

### Forms

Angular provides two approaches for handling forms:

#### Template-Driven Forms

```typescript
import { Component } from '@angular/core';
import { NgForm } from '@angular/forms';

@Component({
  selector: 'app-template-form',
  standalone: true,
  template: `
    <form #userForm="ngForm" (ngSubmit)="onSubmit(userForm)">
      <input name="name" ngModel required minlength="3">
      <input name="email" ngModel type="email" required email>
      <button type="submit" [disabled]="!userForm.valid">Submit</button>
    </form>
  `,
})
export class TemplateFormComponent {
  onSubmit(form: NgForm) {
    console.log(form.value);
  }
}
```

#### Reactive Forms

```typescript
import { Component } from '@angular/core';
import { FormBuilder, FormGroup, Validators } from '@angular/forms';

@Component({
  selector: 'app-reactive-form',
  standalone: true,
  template: `
    <form [formGroup]="userForm" (ngSubmit)="onSubmit()">
      <input formControlName="name">
      <input formControlName="email" type="email">
      <button type="submit" [disabled]="!userForm.valid">Submit</button>
    </form>
  `,
})
export class ReactiveFormComponent {
  userForm = this.fb.group({
    name: ['', [Validators.required, Validators.minLength(3)]],
    email: ['', [Validators.required, Validators.email]],
  });
  
  constructor(private fb: FormBuilder) {}
  
  onSubmit() {
    console.log(this.userForm.value);
  }
}
```

### Observables and RxJS

Angular uses RxJS for handling asynchronous operations:

```typescript
import { HttpClient } from '@angular/common/http';
import { Injectable } from '@angular/core';
import { Observable, catchError, map, of } from 'rxjs';

@Injectable({ providedIn: 'root' })
export class DataService {
  constructor(private http: HttpClient) {}
  
  getData(): Observable<Data[]> {
    return this.http.get<Data[]>('/api/data').pipe(
      map(response => response.filter(item => item.active)),
      catchError(error => {
        console.error('Error:', error);
        return of([]);
      })
    );
  }
}
```

### State Management

For complex state management, consider using:

#### Services with BehaviorSubject

```typescript
import { Injectable } from '@angular/core';
import { BehaviorSubject, Observable } from 'rxjs';

@Injectable({ providedIn: 'root' })
export class StateService {
  private stateSubject = new BehaviorSubject<AppState>({ counter: 0 });
  state$ = this.stateSubject.asObservable();
  
  increment() {
    const current = this.stateSubject.value;
    this.stateSubject.next({ ...current, counter: current.counter + 1 });
  }
}
```

#### NgRx (Recommended for complex applications)

```bash
# Install NgRx
npm install @ngrx/store @ngrx/effects @ngrx/entity @ngrx/store-devtools @ngrx/router-store
```

```typescript
// app.store.ts
import { configureStore } from '@ngrx/store';

export const appStore = configureStore({});

// In app.config.ts
import { provideStore } from '@ngrx/store';
import { appStore } from './app.store';

export const appConfig = {
  providers: [
    provideStore(appStore),
  ],
};
```

## Styling

### Component Styles

Angular supports several approaches to component styling:

#### View Encapsulation

```typescript
@Component({
  selector: 'app-example',
  standalone: true,
  template: '<p>Example</p>',
  styles: ['p { color: red; }'],
  encapsulation: ViewEncapsulation.Emulated, // Default
})
```

Options:
- `ViewEncapsulation.None`: No encapsulation
- `ViewEncapsulation.Emulated`: Emulated encapsulation (default)
- `ViewEncapsulation.ShadowDom`: Native Shadow DOM

#### Style Preprocessors

Angular supports CSS preprocessors like SASS/SCSS:

```bash
# Install SASS
npm install -D sass
```

```typescript
@Component({
  selector: 'app-example',
  standalone: true,
  template: '<p>Example</p>',
  styleUrls: ['./example.component.scss'],
})
```

