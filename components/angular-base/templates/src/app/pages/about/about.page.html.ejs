/**
 * Angular About Page Template
 * 
 * This is the HTML template for the about page.
 * 
 * Source: https://angular.dev/cli/generate
 * Verified: 2026-09-06
 */

<section class="about">
  <div class="container">
    <h1 class="page-title">About {{ appName }}</h1>
    
    <div class="about-content">
      <p class="about-intro">
        {{ appName }} is a modern web application built with Angular {{ angularVersion }}.
        This application was generated by BotKelp to provide a solid foundation for
        building production-ready Angular applications.
      </p>

      <div class="about-section">
        <h2>Technologies</h2>
        <div class="technologies-grid">
          <div class="tech-card" *ngFor="let tech of technologies">
            <div class="tech-icon">
              <span class="tech-initial">{{ tech.name.charAt(0) }}</span>
            </div>
            <div class="tech-info">
              <h3>{{ tech.name }}</h3>
              <p class="tech-version">v{{ tech.version }}</p>
              <a [href]="tech.url" target="_blank" rel="noopener noreferrer" class="tech-link">
                Learn more
              </a>
            </div>
          </div>
        </div>
      </div>

      <div class="about-section">
        <h2>Project Structure</h2>
        <div class="structure">
          <pre><code>├── src/
│   ├── app/
│   │   ├── app.component.ts
│   │   ├── app.config.ts
│   │   ├── app.routes.ts
│   │   ├── pages/
│   │   │   ├── home/
│   │   │   │   └── home.page.ts
│   │   │   └── about/
│   │   │       └── about.page.ts
│   │   └── ...
│   ├── styles.css
│   ├── index.html
│   └── main.ts
├── angular.json
├── package.json
├── tsconfig.json
└── README.md</code></pre>
        </div>
      </div>

      <div class="about-section">
        <h2>Resources</h2>
        <ul class="resources-list">
          <li>
            <a href="https://angular.dev/docs" target="_blank" rel="noopener noreferrer">
              Angular Documentation
            </a>
          </li>
          <li>
            <a href="https://angular.dev/cli" target="_blank" rel="noopener noreferrer">
              Angular CLI
            </a>
          </li>
          <li>
            <a href="https://angular.dev/tutorial" target="_blank" rel="noopener noreferrer">
              Angular Tutorial
            </a>
          </li>
          <li>
            <a href="https://github.com/angular/angular" target="_blank" rel="noopener noreferrer">
              Angular GitHub
            </a>
          </li>
          <li>
            <a href="https://blog.angular.dev" target="_blank" rel="noopener noreferrer">
              Angular Blog
            </a>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>
