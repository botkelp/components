/**
 * Angular About Page Styles
 * 
 * This file contains the styles for the about page.
 * 
 * Source: https://angular.dev/cli/generate
 * Verified: 2026-09-06
 */

.about {
  padding: 2rem 0;
  background-color: #fff;
  min-height: calc(100vh - 200px);
}

.page-title {
  font-size: 2.5rem;
  margin-bottom: 2rem;
  color: #333;
  text-align: center;
}

.about-content {
  max-width: 800px;
  margin: 0 auto;
}

.about-intro {
  font-size: 1.125rem;
  line-height: 1.8;
  margin-bottom: 3rem;
  color: #666;
  text-align: center;
}

.about-section {
  margin-bottom: 3rem;
}

.about-section h2 {
  font-size: 1.75rem;
  margin-bottom: 1.5rem;
  color: #333;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid #667eea;
}

/* Technologies grid */
.technologies-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: 1.5rem;
}

.tech-card {
  display: flex;
  gap: 1rem;
  align-items: flex-start;
  padding: 1.5rem;
  background-color: #f8f9fa;
  border-radius: 0.75rem;
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.tech-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
}

.tech-icon {
  width: 48px;
  height: 48px;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 0.5rem;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.tech-initial {
  font-size: 1.5rem;
  font-weight: 700;
  color: #fff;
}

.tech-info h3 {
  font-size: 1.125rem;
  margin-bottom: 0.25rem;
  color: #333;
}

.tech-version {
  font-size: 0.875rem;
  color: #666;
  margin-bottom: 0.5rem;
}

.tech-link {
  display: inline-flex;
  align-items: center;
  gap: 0.25rem;
  color: #667eea;
  font-size: 0.875rem;
  font-weight: 500;
  transition: color 0.2s ease, gap 0.2s ease;
}

.tech-link:hover {
  color: #5568d3;
  gap: 0.5rem;
}

.tech-link::after {
  content: '→';
}

/* Structure section */
.structure {
  background-color: #f8f9fa;
  padding: 1.5rem;
  border-radius: 0.5rem;
  overflow-x: auto;
}

.structure pre {
  margin: 0;
}

.structure code {
  font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
  font-size: 0.875rem;
  line-height: 1.6;
  color: #333;
  background-color: transparent;
  padding: 0;
  border-radius: 0;
  white-space: pre;
}

/* Resources list */
.resources-list {
  list-style: none;
}

.resources-list li {
  margin-bottom: 0.75rem;
}

.resources-list a {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #667eea;
  font-size: 1rem;
  transition: color 0.2s ease, gap 0.2s ease;
}

.resources-list a:hover {
  color: #5568d3;
  gap: 0.75rem;
}

.resources-list a::before {
  content: '•';
  color: #667eea;
}

/* Responsive adjustments */
@media (max-width: 768px) {
  .page-title {
    font-size: 2rem;
  }

  .about-intro {
    font-size: 1rem;
  }

  .technologies-grid {
    grid-template-columns: 1fr;
  }

  .tech-card {
    flex-direction: column;
    text-align: center;
  }
}
