'use client';

import { PayPalButtons } from '@paypal/react-paypal-js';

/**
 * PayPal Buttons component for rendering PayPal payment buttons.
 * 
 * Usage:
 * import { PayPalButtonsWrapper } from '@/components/paypal-buttons';
 * 
 * <PayPalButtonsWrapper amount={100.00} onSuccess={(details) => console.log(details)} />
 */
export function PayPalButtonsWrapper({
  amount,
  onSuccess,
  onError,
}: {
  amount: number;
  onSuccess: (details: unknown) => void;
  onError: (err: unknown) => void;
}) {
  return (
    <PayPalButtons
      createOrder={(data, actions) => {
        return actions.order.create({
          intent: 'CAPTURE',
          purchase_units: [
            {
              amount: {
                value: amount.toFixed(2),
                currency_code: 'USD',
              },
            },
          ],
        });
      }}
      onApprove={async (data, actions) => {
        const details = await actions.order?.capture();
        onSuccess(details);
      }}
      onError={(err: unknown) => {
        onError(err);
      }}
    />
  );
}
