'use client';

import { PayPalScriptProvider } from '@paypal/react-paypal-js';
import { getPayPalClientId } from '@/lib/paypal/client';

/**
 * PayPal Provider wrapper component.
 * This wraps the application with PayPalScriptProvider to manage
 * the PayPal JS SDK script loading via React context.
 * 
 * The clientId is loaded from NEXT_PUBLIC_PAYPAL_CLIENT_ID environment variable.
 * Set this in your .env.local file.
 */
export function PayPalProviderWrapper({ children }: { children: React.ReactNode }) {
  const clientId = getPayPalClientId();

  return (
    <PayPalScriptProvider
      options={{
        clientId: clientId,
        currency: 'USD',
        intent: 'capture',
      }}
    >
      {children}
    </PayPalScriptProvider>
  );
}
