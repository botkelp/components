import { describe, expect, it } from 'vitest';

import { isPlaceholder, MissingEnvError, optionalEnv, requireEnv } from '../lib/env';

describe('isPlaceholder', () => {
  it.each([undefined, null, '', '   ', 'REPLACE_ME', 'your-api-key', 'changeme', '<secret>', 'sk_test_xxxxxxxx', 'placeholder'])(
    'treats %s as a placeholder',
    (value) => {
      expect(isPlaceholder(value)).toBe(true);
    },
  );

  it.each(['postgresql://app:pw@db.example.com:5432/app', 'sk_live_51HabcDEF', 'https://example.com'])(
    'treats %s as a real value',
    (value) => {
      expect(isPlaceholder(value)).toBe(false);
    },
  );
});

describe('requireEnv', () => {
  it('returns the trimmed value when set', () => {
    expect(requireEnv('API_URL', { API_URL: ' https://api.example.com ' })).toBe('https://api.example.com');
  });

  it('throws MissingEnvError naming the variable when unset or a placeholder', () => {
    expect(() => requireEnv('API_URL', {})).toThrow(MissingEnvError);
    expect(() => requireEnv('API_URL', { API_URL: 'REPLACE_ME' })).toThrow(/API_URL/);
  });
});

describe('optionalEnv', () => {
  it('falls back for missing or placeholder values', () => {
    expect(optionalEnv('PORT', '3000', {})).toBe('3000');
    expect(optionalEnv('PORT', '3000', { PORT: 'your-port' })).toBe('3000');
    expect(optionalEnv('PORT', '3000', { PORT: '8080' })).toBe('8080');
  });
});
