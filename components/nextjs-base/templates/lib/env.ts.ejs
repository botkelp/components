/**
 * Small, dependency-free helpers for reading environment variables.
 *
 * Generated `.env.example` files hold placeholder values (REPLACE_ME, your-...,
 * sk_test_xxx). `isPlaceholder` lets server code tell "configured" from
 * "still the example value" instead of failing deep inside an SDK call.
 */

const PLACEHOLDER_PATTERNS: RegExp[] = [
  /^replace[_-]?me/i,
  /^your[_-]/i,
  /^change[_-]?me/i,
  /^<.*>$/,
  /x{6,}/i,
  /placeholder/i,
];

export type EnvSource = Readonly<Record<string, string | undefined>>;

export function isPlaceholder(value: string | undefined | null): boolean {
  if (value === undefined || value === null) return true;
  const trimmed = value.trim();
  if (trimmed === '') return true;
  return PLACEHOLDER_PATTERNS.some((pattern) => pattern.test(trimmed));
}

export class MissingEnvError extends Error {
  constructor(public readonly variable: string) {
    super(`Missing environment variable ${variable}. Set it in .env.local (see .env.example).`);
    this.name = 'MissingEnvError';
  }
}

/** Read an env var; throw a clear error when it is unset or still a placeholder. */
export function requireEnv(name: string, source: EnvSource = process.env): string {
  const value = source[name];
  if (isPlaceholder(value)) throw new MissingEnvError(name);
  return (value as string).trim();
}

/** Read an env var, falling back when it is unset or still a placeholder. */
export function optionalEnv(name: string, fallback: string, source: EnvSource = process.env): string {
  const value = source[name];
  return isPlaceholder(value) ? fallback : (value as string).trim();
}
