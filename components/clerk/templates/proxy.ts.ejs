/**
 * Attaches the Clerk session to every matched request. clerkMiddleware()
 * protects nothing by default — every route stays public unless you opt in
 * with `auth.protect()` — so the webhook route under app/api/webhooks needs
 * no explicit exclusion.
 *
 * Next.js 16 renamed middleware.ts to proxy.ts; this catalog's nextjs-base
 * pins Next 16, so this targets proxy.ts directly (see authjs's
 * proxy.ts.ejs for the same convention).
 *
 * Source: https://github.com/clerk/clerk-nextjs-app-quickstart/blob/main/proxy.ts
 * Verified: 2026-09-06
 */
import { clerkMiddleware } from '@clerk/nextjs/server';

export default clerkMiddleware();

export const config = {
  matcher: [
    '/((?!_next|[^?]*\\.(?:html?|css|js(?!on)|jpe?g|webp|png|gif|svg|ttf|woff2?|ico|csv|docx?|xlsx?|zip|webmanifest)).*)',
    '/(api|trpc)(.*)',
  ],
};
