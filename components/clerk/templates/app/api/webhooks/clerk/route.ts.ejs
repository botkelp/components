/**
 * Clerk webhook handler using the SDK's own verifyWebhook helper — it reads
 * CLERK_WEBHOOK_SIGNING_SECRET and verifies the raw request body itself, so
 * there's no separate svix dependency or manual signature check to get
 * wrong here.
 *
 * Source: https://github.com/clerk/skills/blob/main/skills/features/clerk-webhooks/SKILL.md
 * Verified: 2026-09-06
 */
import { verifyWebhook } from '@clerk/nextjs/webhooks';
import { NextRequest, NextResponse } from 'next/server';

export async function POST(request: NextRequest) {
  let event;
  try {
    event = await verifyWebhook(request);
  } catch (error) {
    console.error('Clerk webhook verification failed:', error);
    return NextResponse.json({ error: 'Verification failed' }, { status: 400 });
  }

  switch (event.type) {
    case 'user.created':
      // In a real implementation: create a user record in your database.
      console.log(`User created: ${event.data.id}`);
      break;

    case 'user.updated':
      // In a real implementation: sync the updated fields.
      console.log(`User updated: ${event.data.id}`);
      break;

    case 'user.deleted':
      // In a real implementation: delete or deactivate the user record.
      console.log(`User deleted: ${event.data.id}`);
      break;

    default:
      console.log(`Unhandled Clerk webhook event: ${event.type}`);
  }

  return NextResponse.json({ success: true, eventType: event.type });
}
