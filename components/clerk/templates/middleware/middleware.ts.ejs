/**
 * Clerk Middleware
 * 
 * Protects routes with Clerk authentication.
 * 
 * Source: https://clerk.com/docs/nextjs/middleware
 * Verified: 2026-09-06
 */

import { authMiddleware } from '@clerk/nextjs';
import { NextResponse } from 'next/server';

// This example protects all routes except for the sign-in and sign-up pages
// Customize the publicRoutes and ignoredRoutes arrays to match your application's needs

export default authMiddleware({
  // Public routes that don't require authentication
  publicRoutes: ['/', '/api/webhooks/(.*)'],
  
  // Routes to ignore completely (no Clerk middleware applied)
  ignoredRoutes: ['/api/webhooks/clerk'],
  
  // Custom handler for authenticated routes
  afterAuth(auth, req, evt) {
    // Handle users who aren't authenticated
    if (!auth.userId && !auth.isPublicRoute) {
      // Redirect them to the sign in page
      const signInUrl = new URL('/sign-in', req.url);
      signInUrl.searchParams.set('redirect_url', req.url);
      return NextResponse.redirect(signInUrl);
    }
    
    // If the user is logged in and trying to access a public route,
    // redirect them to the home page
    if (auth.userId && auth.isPublicRoute) {
      return NextResponse.redirect(new URL('/', req.url));
    }
    
    // User is authenticated, continue with the request
    return NextResponse.next();
  },
});

export const config = {
  matcher: ['/((?!.*\..*|_next).*)', '/', '/(api|trpc)(.*)'],
};
